rules_version = '2';

// Reglas de seguridad de Firestore para la invitación.
// Cómo aplicarlas: Firebase Console > Firestore Database > Reglas > pegar > Publicar
// (o con la CLI: firebase deploy --only firestore:rules)

service cloud.firestore {
  match /databases/{database}/documents {

    // Solo estas cuentas pueden administrar (mismas listas que en
    // public/js/firebase-config.js).
    // - Novios: con Google, que confirma que el correo es suyo (email_verified).
    //   Así nadie puede registrarse con contraseña usando su correo.
    // - Cuenta de apoyo: solo con contraseña (creada en la consola). Si el
    //   dueño real de ese Gmail entra con Google, no pasa.
    function novios() {
      return request.auth != null
        && request.auth.token.email != null
        && (
          (request.auth.token.email_verified == true
            && request.auth.token.email.lower() in [
              'guadalupe61297rejas@gmail.com',
              'aherncesar@gmail.com'
            ])
          || (request.auth.token.firebase.sign_in_provider == 'password'
            && request.auth.token.email.lower() in [
              'admin@gmail.com'
            ])
        );
    }

    // Confirmaciones: cualquiera puede enviar UNA confirmación válida (sin sesión).
    // La invitación la guarda con el código del enlace como id (rsvps/CODIGO):
    // responder otra vez sería una actualización, y eso solo lo pueden los novios.
    // Solo los novios pueden listarlas, editarlas o borrarlas.
    match /rsvps/{id} {
      allow create: if novios() || (
        request.resource.data.keys().hasOnly(
          ['cantidadPases', 'pasesAdultos', 'pasesNinos', 'nombresAsistentes', 'mensaje', 'asiste', 'invitadoId', 'creadoEn']
        )
        && request.resource.data.cantidadPases is int
        && request.resource.data.cantidadPases >= 0
        && request.resource.data.cantidadPases <= 40
        && request.resource.data.pasesAdultos is int
        && request.resource.data.pasesAdultos >= 0
        && request.resource.data.pasesAdultos <= 20
        && request.resource.data.pasesNinos is int
        && request.resource.data.pasesNinos >= 0
        && request.resource.data.pasesNinos <= 20
        && request.resource.data.nombresAsistentes is string
        && request.resource.data.nombresAsistentes.size() <= 500
        && request.resource.data.mensaje is string
        && request.resource.data.mensaje.size() <= 1000
        && request.resource.data.asiste is bool
      );
      // Con su código el invitado puede ver su propia respuesta (para mostrarle
      // que ya respondió en lugar del formulario).
      allow get: if novios() || exists(/databases/$(database)/documents/enlaces/$(id));
      allow list, update, delete: if novios();
    }

    // Enlaces únicos: un invitado que tiene su token puede LEER solo ese
    // documento (nombre y pases). Nadie sin sesión puede listar la colección.
    match /enlaces/{token} {
      allow get: if true;
      allow list, write: if novios();
    }

    // Lista de invitados (teléfonos, notas, mesa): solo los novios.
    match /invitados/{id} {
      allow read, write: if novios();
    }

    // Mesas: solo los novios.
    match /mesas/{id} {
      allow read, write: if novios();
    }
  }
}
